# Copy this file to .env and fill in real values.
# DATABASE_URL and AUTH_SECRET are required at runtime — auth and the
# Prisma-backed data layer read them directly. Other sections below are
# still placeholders for integrations wired up later.

# --- Database (Prisma) --------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/leadflow_ai?schema=public"

# --- Auth.js (NextAuth) --------------------------------------------------
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Resend (transactional + campaign email) ------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="LeadFlow AI <no-reply@leadflow.ai>"

# --- OpenAI (AI Tools) ------------------------------------------------------
OPENAI_API_KEY=""

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
