# Copy this file to .env and fill in real values.
# DATABASE_URL and AUTH_SECRET are required at runtime — auth and the
# Prisma-backed data layer read them directly. Other sections below are
# still placeholders for integrations wired up later.

# --- Database (Prisma) --------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/nexora?schema=public"

# --- Auth.js (NextAuth) --------------------------------------------------
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Resend (transactional + campaign email) ------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Nexora <no-reply@nexora.ai>"

# --- OpenAI (AI Tools) ------------------------------------------------------
OPENAI_API_KEY=""
# Optional — defaults to "gpt-4o-mini" if unset.
OPENAI_MODEL=""

# --- Web Push (reminders) ---------------------------------------------------
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Cron (reminder scheduler) ----------------------------------------------
# Bearer secret the /api/cron/reminders route requires — set this to whatever
# your scheduler (Vercel Cron, an external pinger) sends as Authorization.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
